# ── Sunshine Tots Daycare — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# Django secret key — generate a new one for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames, e.g. sunshinetots.co.ke,www.sunshinetots.co.ke
# Use * only for local development
ALLOWED_HOSTS=*

# ── Database (leave blank to use SQLite in development) ──────────────────────
# Uncomment and fill in for PostgreSQL in production:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# In development the console backend is used (emails print to terminal).
# Switch to smtp for production:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=hello@sunshinetots.co.ke
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=Sunshine Tots <hello@sunshinetots.co.ke>
